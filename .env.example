# Copy to .env (never commit .env).
# 32-byte key for AES-256-GCM credential encryption (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you lose this key, stored sender passwords cannot be recovered.
SENDERBOLT_MASTER_KEY=
# Secret used to sign session cookies (64+ random hex chars).
SENDERBOLT_SESSION_SECRET=
# Bind to localhost only unless deployed behind a reverse proxy with HTTPS.
HOST=127.0.0.1
PORT=3000
